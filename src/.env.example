SERVICE_NAME=api-gateway
SERVICE_PORT=7005
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:7080
BFF_MOBILE_URL=http://localhost:7010
BFF_BACKOFFICE_URL=http://localhost:7011
AI_ENGINE_API_URL=http://localhost:7001
AI_ENGINE_STATS_URL=http://localhost:7000
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_GENERATION_TIMEOUT_MS=120000
EDGE_API_TOKEN=
# Service-to-service token required in the x-internal-token header on /internal/ai-engine/* routes.
# Required (non-empty) when NODE_ENV is not development/test; the gateway refuses to start otherwise.
INTERNAL_SERVICE_TOKEN=
# Proxy trust for client IP detection (rate limiting): false (default), true, a hop count (1-32)
# or a comma-separated list of proxy IPs/CIDRs. Set it when running behind an ingress/load balancer.
TRUST_PROXY=false
METRICS_LOG_BUFFER_SIZE=1000
