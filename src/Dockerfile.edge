FROM node:22-bookworm-slim AS build
WORKDIR /workspace

COPY contracts-and-schemas /workspace/contracts-and-schemas
COPY shared-sdk-client/typescript /workspace/shared-sdk-client/typescript

# Build the SDK once and drop its dev dependencies before it is copied anywhere.
WORKDIR /workspace/shared-sdk-client/typescript
RUN npm install && npm run build && npm prune --omit=dev

WORKDIR /workspace/api-gateway
COPY api-gateway/src/package.json api-gateway/src/package-lock.json* ./
# The `file:../../shared-sdk-client/typescript` link does not resolve inside the
# image layout, so install the SDK as a real copy of the pruned build instead.
RUN npm install && 	rm -rf node_modules/@axiomnode/shared-sdk-client && 	mkdir -p node_modules/@axiomnode && 	cp -R /workspace/shared-sdk-client/typescript node_modules/@axiomnode/shared-sdk-client

COPY api-gateway/src/app ./app
COPY api-gateway/src/tsconfig.json ./tsconfig.json
COPY api-gateway/src/.env.example ./.env.example
# npm prune re-creates the broken SDK link, so restore the copy afterwards.
RUN npm run build && 	npm prune --omit=dev && 	rm -rf node_modules/@axiomnode/shared-sdk-client && 	mkdir -p node_modules/@axiomnode && 	cp -R /workspace/shared-sdk-client/typescript node_modules/@axiomnode/shared-sdk-client

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# The app writes runtime state under its working directory as the node user.
RUN chown node:node /app
COPY --from=build --chown=node:node /workspace/api-gateway/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/api-gateway/dist ./dist
COPY --from=build --chown=node:node /workspace/api-gateway/.env.example ./.env.example
USER node
EXPOSE 7005
CMD ["node", "dist/app/server.js"]
